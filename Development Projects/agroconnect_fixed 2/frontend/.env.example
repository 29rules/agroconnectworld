# AgroConnectWorld Frontend Environment Variables
# Copy this file to .env and fill in values for your environment

# Backend API base URL (gateway)
# For local development with Vite proxy: leave empty (proxy handles /api)
# For Docker/production: set to your gateway URL
VITE_API_BASE_URL=

# AI Company API base URL (ai-company service)
# For local development: http://localhost:8087
# For Docker: http://localhost:8087 (or your deployed URL)
VITE_AI_API_BASE_URL=http://localhost:8087

# OpenRouter API key for the chatbot (used by Chatbot.jsx directly)
# Get your key from: https://openrouter.ai/
VITE_OPENROUTER_API_KEY=
