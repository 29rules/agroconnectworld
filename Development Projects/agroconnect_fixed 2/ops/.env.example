# =============================================================
# AgroConnectWorld — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================

# ---- Core ----
PROJECT_NAME=agroconnect
DOMAIN=localhost
NGINX_HTTP_PORT=8080
FRONTEND_PORT=8081
GATEWAY_PORT=8080

# ---- PostgreSQL ----
POSTGRES_USER=agro
POSTGRES_PASSWORD=agro_pass
POSTGRES_DB=agro_master
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=agroadmin
MINIO_ROOT_PASSWORD=agroadminpass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- JWT (same secret across gateway, auth-service, ai-company) ----
# Generate: openssl rand -base64 32
JWT_SECRET=2PSi6ESWyf1OImIRWl4FaQ1QhsTpvmU2yi0CJJGqy6Q=

# ---- AI Company (CEO portal AI features) ----
# Get a free key: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ---- Admin Secret (secures /api/auth/promote-ceo) ----
# Generate: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-strong-random-secret
